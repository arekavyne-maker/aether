{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.local/contracts/physics.solver/schema/verification-report.schema.json",
  "title": "Aether Physics Solver Verification Report",
  "description": "Machine-readable verification report emitted by the 'verify' method. The kernel uses this to gate high_fidelity class on convergence, residuals, and conservation checks (I-7).",
  "type": "object",
  "required": ["run_id", "verified_at", "checks", "overall_status"],
  "additionalProperties": false,
  "properties": {
    "run_id": {"type": "string"},
    "verified_at": {"type": "string", "format": "date-time"},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "result"],
        "properties": {
          "name": {"type": "string"},
          "kind": {
            "type": "string",
            "enum": ["residual", "convergence", "conservation", "sanity", "manufactured_solution", "benchmark"]
          },
          "result": {
            "type": "string",
            "enum": ["pass", "warn", "fail"]
          },
          "metric": {"type": ["number", "string", "null"]},
          "tolerance": {"type": ["number", "string", "null"]},
          "diagnostic": {"type": "string"}
        }
      }
    },
    "overall_status": {
      "type": "string",
      "enum": ["pass", "warn", "fail"],
      "description": "If fail, the result bundle's validation_status MUST be 'invalidated' (I-7)."
    }
  }
}
