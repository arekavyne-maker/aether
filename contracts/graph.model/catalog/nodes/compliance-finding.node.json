{
  "type_id": "ComplianceFinding",
  "version": "1.0.0",
  "revisioned": true,
  "immutable": false,
  "allowed_states": [
    "draft",
    "active",
    "retired"
  ],
  "properties_schema": {
    "type": "object",
    "required": [
      "name",
      "status",
      "severity"
    ],
    "additionalProperties": true,
    "properties": {
      "name": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "draft",
          "active",
          "released",
          "superseded",
          "retired"
        ]
      },
      "severity": {
        "type": "string",
        "enum": [
          "info",
          "minor",
          "major",
          "critical"
        ]
      },
      "requirement": {
        "type": "string"
      }
    }
  }
}
