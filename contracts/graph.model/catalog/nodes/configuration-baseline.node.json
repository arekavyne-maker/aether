{
  "type_id": "ConfigurationBaseline",
  "version": "1.0.0",
  "revisioned": true,
  "immutable": false,
  "allowed_states": [
    "draft",
    "released",
    "superseded"
  ],
  "properties_schema": {
    "type": "object",
    "required": [
      "name",
      "status",
      "snapshot"
    ],
    "additionalProperties": true,
    "properties": {
      "name": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "draft",
          "active",
          "released",
          "superseded",
          "retired"
        ]
      },
      "snapshot": {
        "type": "string"
      }
    }
  }
}
