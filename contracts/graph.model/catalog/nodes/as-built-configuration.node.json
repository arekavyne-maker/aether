{
  "type_id": "AsBuiltConfiguration",
  "version": "1.0.0",
  "revisioned": true,
  "immutable": false,
  "allowed_states": [
    "released",
    "superseded"
  ],
  "properties_schema": {
    "type": "object",
    "required": [
      "name",
      "status",
      "build_record"
    ],
    "additionalProperties": true,
    "properties": {
      "name": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "draft",
          "active",
          "released",
          "superseded",
          "retired"
        ]
      },
      "build_record": {
        "type": "string"
      },
      "deviations": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
