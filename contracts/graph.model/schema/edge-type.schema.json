{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.local/contracts/graph.model/schema/edge-type.schema.json",
  "title": "Aether Graph Edge Type",
  "description": "Schema for a registered edge type. Edges are typed, directed, with cardinality constraints (SDP §3.3).",
  "type": "object",
  "required": ["type_id", "version", "directed", "source_types", "target_types"],
  "additionalProperties": false,
  "properties": {
    "type_id": {
      "type": "string",
      "pattern": "^[a-z_]+$",
      "description": "snake_case edge identifier, e.g. 'satisfies', 'verifies'."
    },
    "version": {"type": "string"},
    "directed": {
      "type": "boolean",
      "const": true
    },
    "source_types": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "description": "Allowed source node type_ids."
    },
    "target_types": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "description": "Allowed target node type_ids."
    },
    "cardinality": {
      "type": "object",
      "description": "Cardinality constraints; null means unlimited.",
      "properties": {
        "min_out_per_source": {"type": ["integer", "null"], "minimum": 0},
        "max_out_per_source": {"type": ["integer", "null"], "minimum": 0},
        "min_in_per_target": {"type": ["integer", "null"], "minimum": 0},
        "max_in_per_target": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "properties_schema": {
      "type": "object",
      "additionalProperties": true
    },
    "forbidden_combinations": {
      "type": "array",
      "description": "Additional forbidden (source, target) pairs beyond what source_types and target_types allow.",
      "items": {
        "type": "object",
        "required": ["source", "target"],
        "properties": {
          "source": {"type": "string"},
          "target": {"type": "string"}
        }
      }
    }
  }
}
