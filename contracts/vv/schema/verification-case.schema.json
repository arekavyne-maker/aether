{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.local/contracts/vv/schema/verification-case.schema.json",
  "title": "Aether Verification Case",
  "description": "How a requirement will be verified: the method, the acceptance criterion, and the evidence that satisfies it.",
  "type": "object",
  "required": ["id", "requirement_id", "method", "acceptance_criterion"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "requirement_id": {"type": "string", "minLength": 1},
    "method": {
      "type": "string",
      "enum": ["analysis", "test", "inspection", "demonstration", "similarity"]
    },
    "acceptance_criterion": {"type": "string", "minLength": 1},
    "evidence_ids": {
      "type": "array",
      "items": {"type": "string"}
    },
    "requirement_revision": {"type": "integer", "minimum": 1}
  }
}