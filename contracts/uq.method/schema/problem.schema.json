{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.local/contracts/uq.method/schema/problem.schema.json",
  "title": "Aether UQ Problem",
  "description": "A typed input to a UQ method: which method, which inputs, the analysis model. (SDP §9.4)",
  "type": "object",
  "required": ["method", "inputs", "model"],
  "additionalProperties": false,
  "properties": {
    "method": {
      "type": "string",
      "enum": ["lhs", "monte_carlo", "polynomial_chaos", "sobol", "gp_emulator", "deep_ensemble"]
    },
    "inputs": {
      "type": "array",
      "description": "Uncertain input variables.",
      "items": {
        "type": "object",
        "required": ["name", "distribution"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "distribution": {
            "type": "string",
            "enum": ["normal", "uniform", "lognormal", "beta", "triangular", "deterministic"]
          },
          "params": {
            "type": "object",
            "description": "Distribution parameters (mean/std for normal, min/max for uniform, etc.).",
            "additionalProperties": true
          }
        }
      }
    },
    "model": {
      "type": "object",
      "description": "Reference to the analysis model (a physics.solver plugin call).",
      "required": ["plugin", "plugin_version"],
      "additionalProperties": false,
      "properties": {
        "plugin": {"type": "string"},
        "plugin_version": {"type": "string"},
        "outputs": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Which outputs of the model to capture."
        }
      }
    },
    "samples": {"type": "integer", "minimum": 1, "default": 1000, "description": "Number of samples for MC/LHS."},
    "polynomial_order": {"type": "integer", "minimum": 1, "maximum": 8, "description": "Order for polynomial chaos."},
    "seed": {"type": "integer", "description": "Deterministic seed for reproducibility."}
  }
}
