{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.local/contracts/model-card/schema/model-card.schema.json",
  "title": "Aether Model Card",
  "type": "object",
  "required": ["id", "version", "kind", "intended_use", "validity_envelope", "lifecycle", "metrics"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "kind": {"type": "string", "enum": ["surrogate", "rom", "ml", "empirical", "hybrid"]},
    "intended_use": {"type": "string", "minLength": 1},
    "prohibited_use": {"type": "array", "items": {"type": "string"}},
    "validity_envelope": {
      "type": "object",
      "additionalProperties": {"type": "string"},
      "description": "Named ranges the model is valid within; outside them it must refuse or fall back."
    },
    "training_lineage": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "data_hash": {"type": "string"},
        "data_rights": {"type": "string"},
        "code_hash": {"type": "string"},
        "weight_hash": {"type": "string"}
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "value", "dataset"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "value": {"type": "number"},
          "unit": {"type": "string"},
          "dataset": {"type": "string"},
          "tolerance": {"type": "number"}
        }
      }
    },
    "uncertainty_method": {"type": "string"},
    "ood_method": {"type": "string"},
    "fallback": {"type": "string", "description": "Solver or method used when the input is outside the envelope."},
    "lifecycle": {"type": "string", "enum": ["research", "benchmarked", "independently_validated", "approved", "deprecated"]},
    "approved_by": {"type": "string"},
    "rollback_version": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}}
  }
}
