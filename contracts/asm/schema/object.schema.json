{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.local/contracts/asm/schema/object.schema.json",
  "title": "Aether ASM Object",
  "type": "object",
  "required": ["id", "kind", "name", "current", "revisions", "content"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "kind": {
      "type": "string",
      "enum": [
        "program", "aircraft_configuration", "product", "assembly", "part",
        "interface", "variant", "configuration_baseline", "change_request",
        "effectivity", "requirement", "verification_case", "validation_case",
        "material_assignment", "environment_case"
      ]
    },
    "name": {"type": "string", "minLength": 1},
    "current": {"type": "integer", "minimum": 1},
    "revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["number", "state", "author", "content_hash"],
        "additionalProperties": false,
        "properties": {
          "number": {"type": "integer", "minimum": 1},
          "state": {"type": "string", "enum": ["draft", "in_review", "released", "superseded", "retired"]},
          "author": {"type": "string"},
          "created_at": {"type": "string"},
          "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "supersedes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "content": {"type": "object", "additionalProperties": true}
  }
}
