{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.local/contracts/asm/schema/interface.schema.json",
  "title": "Aether ASM Interface",
  "type": "object",
  "required": ["id", "provider", "consumer", "direction", "provides", "requires"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "consumer": {"type": "string", "minLength": 1},
    "direction": {"type": "string", "enum": ["provides", "consumes", "bidirectional"]},
    "provides": {"type": "array", "items": {"$ref": "#/$defs/parameter"}},
    "requires": {"type": "array", "items": {"$ref": "#/$defs/parameter"}}
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "required": ["name", "quantity", "unit"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "quantity": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "frame": {"type": "string"}
      }
    }
  }
}
