{
  "contract_id": "aether.asm",
  "version": "0.1.0",
  "title": "Aether Aerospace Systems Model",
  "description": "Programme, product, configuration, interface, lifecycle, and snapshot semantics for aerospace engineering objects (ADR-0026, ADR-0030).",
  "methods": ["create", "revise", "release", "validate_interface", "capture_snapshot", "diff_snapshot"],
  "schemas": [
    {
      "id": "https://aether.local/contracts/asm/schema/object.schema.json",
      "path": "schema/object.schema.json",
      "schema_version": "https://json-schema.org/draft/2020-12/schema"
    },
    {
      "id": "https://aether.local/contracts/asm/schema/interface.schema.json",
      "path": "schema/interface.schema.json",
      "schema_version": "https://json-schema.org/draft/2020-12/schema"
    },
    {
      "id": "https://aether.local/contracts/asm/schema/snapshot.schema.json",
      "path": "schema/snapshot.schema.json",
      "schema_version": "https://json-schema.org/draft/2020-12/schema"
    }
  ],
  "vocabularies": [
    { "namespace": "asm_kind", "version": "0.1.0", "closed": false },
    { "namespace": "lifecycle_state", "version": "0.1.0", "closed": true, "values": ["draft", "in_review", "released", "superseded", "retired"] },
    { "namespace": "interface_direction", "version": "0.1.0", "closed": true, "values": ["provides", "consumes", "bidirectional"] }
  ],
  "conformance_suite": {
    "entry": "python/aether_testing/tests/test_contract_conformance.py",
    "version": "0.1.0"
  }
}
