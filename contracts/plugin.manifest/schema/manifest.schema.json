{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.local/contracts/plugin.manifest/schema/manifest.schema.json",
  "title": "Aether Plugin Manifest",
  "description": "Manifest schema for Aether plugins (SDP §5.2). Every plugin declares its identity, contracts, capabilities, resources, isolation, runtime, and provenance template.",
  "type": "object",
  "required": [
    "manifest_version",
    "plugin",
    "contracts",
    "capabilities",
    "resources",
    "isolation",
    "runtime"
  ],
  "additionalProperties": false,
  "properties": {
    "manifest_version": {
      "type": "string",
      "const": "1.2",
      "description": "Manifest schema version. Pinned per release; breaking changes require major bump."
    },
    "plugin": {
      "type": "object",
      "required": ["id", "name", "version", "vendor"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9]+)+$",
          "description": "Reverse-DNS plugin id, immutable for the lifetime of the plugin."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
          "description": "Semver 2.0 of the plugin."
        },
        "vendor": {
          "type": "string"
        },
        "license_ref": {
          "type": "string",
          "description": "Reference to a license document in the bundle; SPDX id preferred."
        },
        "signature": {
          "type": "object",
          "required": ["alg", "keyid", "sig"],
          "additionalProperties": false,
          "properties": {
            "alg": {"type": "string", "const": "ed25519"},
            "keyid": {"type": "string", "description": "Signing key identifier; resolves to a trusted key in the offline registry."},
            "sig": {"type": "string", "pattern": "^[A-Za-z0-9+/=]+$", "description": "Base64-encoded Ed25519 signature over the canonicalized manifest."}
          }
        }
      }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "role"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^aether\\.[a-z0-9]+(\\.[a-z0-9]+)+$",
            "description": "Contract id, e.g. aether.physics.solver."
          },
          "version": {
            "type": "string",
            "description": "Accepted semver range, e.g. '>=1.3.0 <2.0.0'."
          },
          "role": {
            "type": "string",
            "enum": ["implements", "consumes", "extends"],
            "description": "implements: this plugin provides the contract. consumes: this plugin uses the contract. extends: this plugin augments an existing contract (rare)."
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "description": "Structured, machine-queryable facts about the plugin (SDP §5.3).",
      "additionalProperties": true,
      "properties": {
        "physics": {
          "type": "object",
          "additionalProperties": {"type": "boolean"}
        },
        "compute": {
          "type": "object",
          "additionalProperties": {"type": "boolean"}
        },
        "features": {
          "type": "object",
          "additionalProperties": {"type": "boolean"}
        }
      }
    },
    "resources": {
      "type": "object",
      "required": ["defaults", "maximums"],
      "additionalProperties": false,
      "properties": {
        "defaults": {
          "type": "object",
          "properties": {
            "memory_gb": {"type": "integer", "minimum": 0},
            "cores": {"type": "integer", "minimum": 1},
            "disk_gb": {"type": "integer", "minimum": 0},
            "runtime_h": {"type": "number", "minimum": 0}
          }
        },
        "maximums": {
          "type": "object",
          "properties": {
            "memory_gb": {"type": "integer", "minimum": 0},
            "cores": {"type": "integer", "minimum": 1},
            "disk_gb": {"type": "integer", "minimum": 0},
            "runtime_h": {"type": "number", "minimum": 0}
          }
        }
      }
    },
    "isolation": {
      "type": "object",
      "required": ["level", "filesystem", "network"],
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "enum": ["process", "container", "vm"]
        },
        "filesystem": {
          "type": "string",
          "enum": ["none", "readonly", "sandbox"]
        },
        "network": {
          "type": "string",
          "enum": ["deny", "allowlist"],
          "description": "deny: no network access. allowlist: only declared endpoints reachable."
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["entry"],
      "additionalProperties": false,
      "properties": {
        "entry": {
          "type": "object",
          "required": ["kind", "path"],
          "additionalProperties": false,
          "properties": {
            "kind": {"type": "string", "enum": ["native-binary", "python-module", "container"]},
            "path": {"type": "string"},
            "args": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        },
        "env_manifest_ref": {
          "type": "string",
          "description": "Reference to a pinned environment manifest inside the bundle."
        }
      }
    },
    "airgap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offline_install": {"type": "boolean"},
        "data_bundle": {"type": "string"}
      }
    },
    "provenance_template": {
      "type": "string",
      "description": "Reference to a provenance record template (prov/*.vN.json)."
    },
    "policy": {
      "type": "object",
      "additionalProperties": true,
      "description": "Informational hints; the policy engine is the source of truth."
    }
  }
}
