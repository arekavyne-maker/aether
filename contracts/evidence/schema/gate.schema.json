{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.local/contracts/evidence/schema/gate.schema.json",
  "title": "Aether Release Gate",
  "type": "object",
  "required": ["id", "description", "requirements", "waiver_allowed"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["class", "min_count"],
        "additionalProperties": false,
        "properties": {
          "class": {"type": "string"},
          "min_count": {"type": "integer", "minimum": 1},
          "require_credibility": {"type": "boolean"}
        }
      }
    },
    "waiver_allowed": {"type": "boolean"}
  }
}
