# CLI scratch databases (transient working state of the
# aether CLI; see infra/run/ for the running directory).
infra/run/*.aether.db
infra/run/_mvr05/

# Scratch artifacts from CLI runs at the monorepo root
/benchmarks/
/aether-platform-eval.zip

# Signing / keys (NEVER commit)
*.pem
*.key
*.p12
secrets/
.hypothesis/

# Local agent metadata
.freebuff/

# Local Aether state (graph DB, scratch)
/.aether/

# Vendored native binaries (fetched by scripts/fetch_calculix.sh, not committed).
# They are platform-specific and large; the fetch script pins them by SHA-256.
/vendor/bin/
/vendor/lib/
